module decodificar_num(
	input [31:0] inst,
	input clock,
	input seletor,
	output [6:0] HEX0,
	output [6:0] HEX1,
	output [6:0] HEX2,
	output [6:0] HEX3
	);
	
	reg [31:0] instrucao;
	
	reg [3:0] valor1, valor2, valor3, valor4;
	
	always @(posedge clock) begin
		instrucao <= instrucao;
		
		valor4 <= seletor ? instrucao[31:28] : instrucao[14:11];
		valor3 <= seletor ? instrucao[27:24] : instrucao[10:8];
		valor2 <= seletor ? instrucao[23:19] : instrucao[7:4];
		valor1 <= seletor ? instrucao[18:15] : instrucao[3:0];
		
	end

	
decodificar_segmentos d1(
    .valor(valor4),    
    .clock(clock),          
    .saida(HEX3) 
);


decodificar_segmentos d2(
    .valor(valor3),    
    .clock(clock),          
    .saida(HEX2) 
);

decodificar_segmentos d3(
    .valor(valor2),    
    .clock(clock),          
    .saida(HEX1) 
);


decodificar_segmentos d4(
    .valor(valor1),    
    .clock(clock),          
    .saida(HEX0) 
);

	
	
endmodule