module IR(clk, rst_n, IR, data_out, new_data_pulse);

  input   clk;
  input   rst_n;
  input   IR;
  output [31:0] data_out;      // Saída de 32 bits
  output new_data_pulse;        // Pulso quando dados novos chegam
 
  reg [31:0] data_out;
  reg new_data_pulse;
 
  reg [7:0] led1, led2, led3, led4;
  reg [15:0] irda_data;
  reg [31:0] get_data;
  reg [5:0]  data_cnt;
  reg [2:0]  cs, ns;
  reg error_flag;
  reg data_ready;               // Flag para indicar dados prontos

  //----------------------------------------------------------------------------
  // Sincronização do sinal IR para evitar metaestabilidade
  reg irda_reg0;
  reg irda_reg1;
  reg irda_reg2;
  wire irda_neg_pulse;
  wire irda_pos_pulse;
  wire irda_chang;
   
  always @ (posedge clk)
    if(!rst_n)
      begin
        irda_reg0 <= 1'b0;
        irda_reg1 <= 1'b0;
        irda_reg2 <= 1'b0;
      end
    else
      begin
        irda_reg0 <= IR;
        irda_reg1 <= irda_reg0;
        irda_reg2 <= irda_reg1;
      end
     
  assign irda_chang = irda_neg_pulse | irda_pos_pulse;
  assign irda_neg_pulse = irda_reg2 & (~irda_reg1);
  assign irda_pos_pulse = (~irda_reg2) & irda_reg1;

  //----------------------------------------------------------------------------
  // Contadores para temporização
  reg [10:0] counter;
  reg [8:0]  counter2;
  wire check_9ms;
  wire check_4ms;
  wire low;
  wire high;
 
  always @ (posedge clk)
    if (!rst_n)
      counter <= 11'd0;
    else if (irda_chang)
      counter <= 11'd0;
    else if (counter == 11'd1750)
      counter <= 11'd0;
    else
      counter <= counter + 1'b1;
 
  always @ (posedge clk)
    if (!rst_n)
      counter2 <= 9'd0;
    else if (irda_chang)
      counter2 <= 9'd0;
    else if (counter == 11'd1750)
      counter2 <= counter2 + 1'b1;
 
  assign check_9ms = ((217 < counter2) & (counter2 < 297));
  assign check_4ms = ((88 < counter2) & (counter2 < 168));
  assign low  = ((6 < counter2) & (counter2 < 26));
  assign high = ((38 < counter2) & (counter2 < 58));

  //----------------------------------------------------------------------------
  // Máquina de estados
  parameter IDLE       = 3'b000,
            LEADER_9   = 3'b001,
            LEADER_4   = 3'b010,
            DATA_STATE = 3'b100;
 
  always @ (posedge clk)
    if (!rst_n)
      cs <= IDLE;
    else
      cs <= ns;
     
  always @ (*)
    case (cs)
      IDLE:
        if (~irda_reg1)
          ns = LEADER_9;
        else
          ns = IDLE;
   
      LEADER_9:
        if (irda_pos_pulse)
          begin
            if (check_9ms)
              ns = LEADER_4;
            else
              ns = IDLE;
          end
        else
          ns = LEADER_9;
   
      LEADER_4:
        if (irda_neg_pulse)
          begin
            if (check_4ms)
              ns = DATA_STATE;
            else
              ns = IDLE;
          end
        else
          ns = LEADER_4;
   
      DATA_STATE:
        if ((data_cnt == 6'd32) & irda_reg2 & irda_reg1)
          ns = IDLE;
        else if (error_flag)
          ns = IDLE;
        else
          ns = DATA_STATE;
          
      default:
        ns = IDLE;
    endcase

  //----------------------------------------------------------------------------
  // Lógica sequencial da máquina de estados
  always @ (posedge clk)
    if (!rst_n)
      begin
        data_cnt <= 6'd0;
        get_data <= 32'd0;
        error_flag <= 1'b0;
        data_ready <= 1'b0;
      end
    else if (cs == IDLE)
      begin
        data_cnt <= 6'd0;
        get_data <= 32'd0;
        error_flag <= 1'b0;
        data_ready <= 1'b0;
      end
    else if (cs == DATA_STATE)
      begin
        if (irda_pos_pulse)
          begin
            if (!low)
              error_flag <= 1'b1;
          end
        else if (irda_neg_pulse)
          begin
            if (low)
              get_data[0] <= 1'b0;
            else if (high)
              get_data[0] <= 1'b1;
            else
              error_flag <= 1'b1;
             
            get_data[31:1] <= get_data[30:0];
            data_cnt <= data_cnt + 1'b1;
            
            // Sinaliza dados prontos quando completar 32 bits
            if (data_cnt == 6'd31)
              data_ready <= 1'b1;
          end
      end

  //----------------------------------------------------------------------------
  // Geração do pulso de novos dados (1 ciclo de clock)
  reg data_ready_prev;
  
  always @ (posedge clk)
    if (!rst_n)
      data_ready_prev <= 1'b0;
    else
      data_ready_prev <= data_ready;
  
  always @ (posedge clk)
    if (!rst_n)
      new_data_pulse <= 1'b0;
    else
      new_data_pulse <= data_ready & ~data_ready_prev;

  //----------------------------------------------------------------------------
  // Extração dos bytes recebidos
  always @ (posedge clk)
    if (!rst_n)
      begin
        led1 <= 8'd0;
        led2 <= 8'd0;
        led3 <= 8'd0;
        led4 <= 8'd0;
      end
    else if ((data_cnt == 6'd32) & irda_reg1)
      begin
        led1 <= get_data[7:0];
        led2 <= get_data[15:8];
        led3 <= get_data[23:16];
        led4 <= get_data[31:24];
      end
 
  //----------------------------------------------------------------------------
  // Decodificação dos comandos 0 a 3 para saída de 32 bits
  always @ (posedge clk)
    if (!rst_n)
      data_out <= 32'd0;
    else if (new_data_pulse)
      begin
        case(led2)
          8'b01101000: // Controle remoto 0
            data_out <= 32'h80000000;
          
          8'b00110000: // Controle remoto 1
            data_out <= 32'h60000000;
          
          8'b00011000: // Controle remoto 2
            data_out <= 32'hA0000000;
          
          8'b01111010: // Controle remoto 3
            data_out <= 32'hC0000000;
          
          default:
            data_out <= data_out; // Mantém valor anterior para comandos não reconhecidos
        endcase
      end

endmodule