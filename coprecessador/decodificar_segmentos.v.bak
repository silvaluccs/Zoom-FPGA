module decodificar_segmentos(
    input [3:0] valor,    // Valor de 4 bits em hexadecimal
    input clock,          // Sinal de clock
    output reg [6:0] saida // Saída para os 7 segmentos
);

    always @(posedge clock) begin
        case (valor)
            4'h0: saida <= 7'b1000000; // 0
            4'h1: saida <= 7'b1111001; // 1
            4'h2: saida <= 7'b0100100; // 2
            4'h3: saida <= 7'b0110000; // 3
            4'h4: saida <= 7'b0011001; // 4
            4'h5: saida <= 7'b0010010; // 5
            4'h6: saida <= 7'b0000010; // 6
            4'h7: saida <= 7'b1111000; // 7
            4'h8: saida <= 7'b0000000; // 8
            4'h9: saida <= 7'b0010000; // 9
            4'hA: saida <= 7'b0001000; // A
            4'hB: saida <= 7'b0000011; // b
            4'hC: saida <= 7'b1000110; // C
            4'hD: saida <= 7'b0100001; // d
            4'hE: saida <= 7'b0000110; // E
            4'hF: saida <= 7'b0001110; // F
            default: saida <= 7'b1111111; // Default (apagado)
        endcase
    end

endmodule
