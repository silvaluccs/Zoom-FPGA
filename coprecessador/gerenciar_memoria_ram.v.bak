module gerenciar_memoria_ram(
	input clock_25_mhz,
	input clock_50_mhz,
	input [16:0] endereco_escrita,
	input [16:0] endereco_leitura,
	input [7:0] pixels_para_escrita,
	input escrita_dados,
	output [7:0] pixel_leitura,
	output proximo_pixels_instrucao,
);


wire [7:0] pixel_escrito;

ram_leitura_2 ram_leitura_2_inst(
	.address_a(endereco_leitura),
	.address_b(endereco_escrita),
	.clock_a(clock_25_mhz),
	.clock_b(clock_50_mhz),
	.data_a(8'd0),
	.data_b(pixels_para_escrita),
	.wren_a(1'b0),
	.wren_b(escrita_dados),
	.q_a(pixel_leitura),
	.q_b(pixel_escrito));
	
	assign proximo_pixels_instrucao = pixel_escrito == pixels_para_escrita;

endmodule

